---
import "../styles/global.css";
import { DATA } from "@/data/resume";
import { CONFIG } from "@/data/config";
import { absoluteURL, getProfile, homePath, blogPath, type Locale } from "@/data/profile";
import LanguagePreference from "@/components/LanguagePreference.astro";
import NavbarIsland from "@/components/NavbarIsland";
import { FlickeringGrid } from "@/components/magicui/flickering-grid";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  locale?: Locale;
  alternates?: Partial<Record<Locale, string>>;
  markdownPath?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  absoluteTitle?: boolean;
}

const {
  title,
  absoluteTitle = false,
  locale = "en",
  description = getProfile(locale).description,
  image,
  canonicalURL = absoluteURL(Astro.url.pathname),
  alternates = {},
  markdownPath,
  noindex = false,
  ogType = "website",
} = Astro.props;

const pageTitle = absoluteTitle && title ? title : title
  ? CONFIG.seo.titleTemplate.replace("%s", title).replace("%n", DATA.name)
  : DATA.name;
const ogImage = new URL(image || DATA.ogImage, CONFIG.site.url).href;
const language = locale === "zh" ? "zh-Hans" : "en";
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
const robots = noindex ? "noindex, follow" : CONFIG.seo.robots;
const languages = Object.entries(alternates) as [Locale, string][];
const nav = locale === "zh" ? { home: "首页", blog: "文章", language: "语言" } : { home: "Home", blog: "Blog", language: "Language" };

const { light, dark, radius } = CONFIG.theme;
const { baseFontSize } = CONFIG.typography;
---

<html
  lang={language}
  style={`font-size: ${baseFontSize}%;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- FOUC prevention: apply stored theme before first paint -->
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          if (
            theme === "dark" ||
            (!theme &&
              window.matchMedia("(prefers-color-scheme: dark)").matches)
          ) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }
        } catch (_) {}
      })();
    </script>

    <!-- Theme variables from config.ts -->
    <style
      set:html={`
      :root {
        --radius: ${radius};
        --background: ${light.background};
        --foreground: ${light.foreground};
        --card: ${light.card};
        --card-foreground: ${light.cardForeground};
        --popover: ${light.popover};
        --popover-foreground: ${light.popoverForeground};
        --primary: ${light.primary};
        --primary-foreground: ${light.primaryForeground};
        --secondary: ${light.secondary};
        --secondary-foreground: ${light.secondaryForeground};
        --muted: ${light.muted};
        --muted-foreground: ${light.mutedForeground};
        --accent: ${light.accent};
        --accent-foreground: ${light.accentForeground};
        --destructive: ${light.destructive};
        --border: ${light.border};
        --input: ${light.input};
        --ring: ${light.ring};
      }
      .dark {
        --background: ${dark.background};
        --foreground: ${dark.foreground};
        --card: ${dark.card};
        --card-foreground: ${dark.cardForeground};
        --popover: ${dark.popover};
        --popover-foreground: ${dark.popoverForeground};
        --primary: ${dark.primary};
        --primary-foreground: ${dark.primaryForeground};
        --secondary: ${dark.secondary};
        --secondary-foreground: ${dark.secondaryForeground};
        --muted: ${dark.muted};
        --muted-foreground: ${dark.mutedForeground};
        --accent: ${dark.accent};
        --accent-foreground: ${dark.accentForeground};
        --destructive: ${dark.destructive};
        --border: ${dark.border};
        --input: ${dark.input};
        --ring: ${dark.ring};
      }
    `}
    ></style>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={DATA.name} />
    {languages.map(([code, path]) => <link rel="alternate" hreflang={code === "zh" ? "zh-Hans" : "en"} href={absoluteURL(path)} />)}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={absoluteURL(alternates.en)} />}
    {markdownPath && <link rel="alternate" type="text/markdown" href={absoluteURL(markdownPath)} />}
    <link rel="describedby" type="text/plain" href={absoluteURL("/llms.txt")} />

    <!-- Robots -->
    <meta name="robots" content={robots} />
    <meta
      name="googlebot"
      content={noindex ? "noindex, follow" : "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}
    />

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={DATA.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={DATA.name + " · 李叙宁"} />
    {languages.filter(([code]) => code !== locale).map(([code]) => <meta property="og:locale:alternate" content={code === "zh" ? "zh_CN" : "en_US"} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content={CONFIG.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased relative">
    <!-- FlickeringGrid header background - matches template exactly -->
    <div class="absolute inset-0 top-0 left-0 right-0 h-25 overflow-hidden z-0">
      <FlickeringGrid
        client:load
        className="h-full w-full"
        squareSize={2}
        gridGap={2}
        style={{
          maskImage: "linear-gradient(to bottom, black, transparent)",
          WebkitMaskImage: "linear-gradient(to bottom, black, transparent)",
        }}
      />
    </div>

    <!-- Main content wrapper - matches template's z-10 container exactly -->
    <div class="relative z-10 max-w-2xl mx-auto py-12 pb-24 sm:py-24 px-6">
      <nav aria-label={nav.language} class="mb-10 flex flex-wrap items-center justify-between gap-4 text-sm">
        <div class="flex gap-4"><a href={homePath(locale)} class="hover:underline">{nav.home}</a><a href={blogPath(locale)} class="hover:underline">{nav.blog}</a></div>
        <div class="flex gap-3">
          <a href={alternates.en || "/"} lang="en" hreflang="en" data-language="en" aria-current={locale === "en" ? "true" : undefined} class:list={["hover:underline", { "font-semibold underline underline-offset-4": locale === "en" }]}>English</a>
          <a href={alternates.zh || "/zh/"} lang="zh-Hans" hreflang="zh-Hans" data-language="zh" aria-current={locale === "zh" ? "true" : undefined} class:list={["hover:underline", { "font-semibold underline underline-offset-4": locale === "zh" }]}>简体中文</a>
        </div>
      </nav>
      <slot />
      <footer class="mt-14 border-t border-border pt-6 text-xs text-muted-foreground flex flex-wrap gap-4">
        <a href={locale === "zh" ? "/zh/index.md" : "/index.md"}>Markdown</a>
        <a href="/profile.json">JSON</a><a href="/llms.txt">llms.txt</a><a href="/sitemap.xml">Sitemap</a>
      </footer>
    </div>

    <!-- Navbar: ThemeProvider + TooltipProvider + Navbar all in one React island -->
    <NavbarIsland client:load locale={locale} />
    <LanguagePreference />
  </body>
</html>
